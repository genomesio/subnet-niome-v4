# Storage: set either the AWS S3 settings or the Google Drive settings.
# S3 is used when all AWS values are set; otherwise Google Drive.

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Google Drive
GOOGLE_SERVICE_ACCOUNT_FILE= # path to the service account JSON key
GOOGLE_DRIVE_ROOT_FOLDER_ID= # ID of the folder submissions and bundles are stored under
